{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "vb_dotnet",
      "camelcase": "VbDotnet",
      "title": "VbDotnet",
      "scope": "source.vb_dotnet",
      "file-types": [
        "vb"
      ],
      "injection-regex": "^vb_dotnet$"
    }
  ],
  "metadata": {
    "version": "0.21.0",
    "license": "MIT",
    "description": "Tree sitter grammar for VB.NET",
    "authors": [
      {
        "name": "CodeAnt AI",
        "email": "chinmay@codeant.ai"
      }
    ],
    "links": {
      "repository": "https://github.com/CodeAnt-AI/tree-sitter-vb-dotnet"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}